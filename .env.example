DOGOFLOW_ENV=development
DOGOFLOW_URL=
DOGOFLOW_TIMEZONE=Africa/Accra
DOGOFLOW_DB_HOST=127.0.0.1
DOGOFLOW_DB_NAME=dogo
DOGOFLOW_DB_USER=root
DOGOFLOW_DB_PASS=
DOGOFLOW_PAYSTACK_SECRET=
# Paystack secret key (never commit a live key to source control)
# DOGOFLOW_PAYSTACK_SECRET=sk_test_xxxxxxxxxxxxxxxxx

# SMTP mail (DirectAdmin / DogoFlow system emails)
DOGOFLOW_MAIL_HOST=mail.dogoflow.com
DOGOFLOW_MAIL_PORT=587
DOGOFLOW_MAIL_USERNAME=noreply@dogoflow.com
DOGOFLOW_MAIL_PASSWORD=
DOGOFLOW_MAIL_ENCRYPTION=tls
DOGOFLOW_MAIL_FROM=noreply@dogoflow.com
DOGOFLOW_MAIL_FROM_NAME=DogoFlow
